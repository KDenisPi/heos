#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        systemctl stop heos-home.service >/dev/null 2>&1 || true
        systemctl disable heos-home.service >/dev/null 2>&1 || true
        ;;
esac
# Compiled files are not in the package; remove them so dpkg can replace or remove the code.
find /opt/heos-home/src -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
exit 0
