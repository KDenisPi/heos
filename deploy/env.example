# /etc/heos-home/env: settings of the heos-home service (installed by the .deb,
# kept across upgrades). Change, then: sudo systemctl restart heos-home
HEOS_HOME_DATA_DIR=/var/lib/heos-home
HEOS_HOME_PORT=8080
# Manual device IP(s) if SSDP multicast does not work on your network (F1.2):
#HEOS_HOME_HOSTS=192.168.1.50
#HEOS_HOME_TOKEN=change-me
# Key for the saved HEOS password; the .deb creates it on first install.
#HEOS_HOME_KEY_FILE=/etc/heos-home/key
#HEOS_HOME_STATIC_DIR=/opt/heos-home/web/dist
HEOS_HOME_LOG_LEVEL=INFO
# Log file, rotated daily; the systemd unit already sets this path.
#HEOS_HOME_LOG_FILE=/var/log/heos-home/heos-home.log
#HEOS_HOME_LOG_BACKUP_COUNT=7
# JSON lines instead of plain text:
#HEOS_HOME_LOG_JSON=on
