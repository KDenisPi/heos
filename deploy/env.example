# Copy to /etc/heos-home/env (mode 600) and adjust.
HEOS_HOME_DATA_DIR=/var/lib/heos-home
HEOS_HOME_PORT=8080
# Manual device IP(s) if SSDP multicast does not work on your network (F1.2):
#HEOS_HOME_HOSTS=192.168.1.50
#HEOS_HOME_TOKEN=change-me
# Key for the saved HEOS password; create it at install time (see README).
#HEOS_HOME_KEY_FILE=/etc/heos-home/key
#HEOS_HOME_STATIC_DIR=/opt/heos-home/web/dist
HEOS_HOME_LOG_LEVEL=INFO
